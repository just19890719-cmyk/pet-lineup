## 多國語言：以繁體中文原文當索引，查不到就顯示原文。
## 用法：const I18n := preload("res://scripts/i18n.gd")；I18n.t("撤回")
## 新增語言：LANGS、NATIVE、FONT_OF 各加一項，TABLE 每一句後面多加一個翻譯。
## 新增句子：在 TABLE 加一列，順序必須跟 LANGS 第 2 個以後一致。

const LANGS := ["zh_TW", "zh_CN", "en", "ja", "ko", "de", "fr", "es", "pt", "it", "ru", "id", "vi", "nl"]
const NATIVE := ["繁體中文", "简体中文", "English", "日本語", "한국어", "Deutsch", "Français", "Español", "Português", "Italiano", "Русский", "Bahasa Indonesia", "Tiếng Việt", "Nederlands"]
## 每種語言優先使用的字型（其餘字型當備援）
const FONT_OF := ["TC", "SC", "TC", "JP", "KR", "TC", "TC", "TC", "TC", "TC", "TC", "TC", "TC", "TC"]

static var lang: int = 0


static func t(key: String) -> String:
	if lang == 0:
		return key
	var row = TABLE.get(key, null)
	if row == null or lang - 1 >= row.size():
		return key
	return row[lang - 1]


## 依系統語言挑一個；都不符合就用英文
static func detect(locale: String) -> int:
	var lc := locale.replace("-", "_")
	var low := lc.to_lower()
	if low.begins_with("zh"):
		if low.contains("hans") or low.contains("cn") or low.contains("sg"):
			return 1
		return 0
	var code := low.get_slice("_", 0)
	for i in LANGS.size():
		if LANGS[i] == code:
			return i
	return 2


