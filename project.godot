; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/enabled=false
general/ios/app_id="ca-app-pub-6023320630940952~1829023658"

[application]

config/name="萌寵排排站"
config/name_localized={
"de": "Pet Lineup",
"en": "Pet Lineup",
"es": "Pet Lineup",
"fr": "Pet Lineup",
"id": "Pet Lineup",
"it": "Pet Lineup",
"ja": "ペットならべ",
"ko": "펫 줄세우기",
"nl": "Pet Lineup",
"pt": "Pet Lineup",
"ru": "Pet Lineup",
"vi": "Pet Lineup",
"zh_CN": "萌宠排排站"
}
config/description="點欄位拿起最上面同款動物，排滿一整欄就消除。"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(1, 0.86, 0.9, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/ui/splash.png"
config/icon="res://icon.png"

[display]

window/size/viewport_width=480
window/size/viewport_height=854
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1
window/stretch/aspect.web="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

texture={
"mipmaps/generate": true
}

[rendering]

textures/canvas_textures/default_texture_filter=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.75, 0.9, 1, 1)
