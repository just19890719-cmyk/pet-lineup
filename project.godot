; 萌寵排排站：可愛動物盲盒排序益智遊戲（Godot 4.7）
config_version=5

[application]

config/name="萌寵排排站"
config/description="點欄位拿起最上面同款動物，排滿一整欄就消除。"
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
boot_splash/bg_color=Color(1, 0.86, 0.9, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=480
window/size/viewport_height=854
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/stretch/aspect.web="keep"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

texture={
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=2
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.75, 0.9, 1, 1)
